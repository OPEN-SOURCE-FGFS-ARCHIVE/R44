    <object-name>fuselage</object-name>
    <object-name>patins</object-name>
    <object-name>supportlampe</object-name>
    <object-name>protection</object-name>
    <object-name>porteAG</object-name>
    <object-name>porteAD</object-name>
    <object-name>porteBG</object-name>
    <object-name>porteBD</object-name>
    <object-name>pate</object-name>
    <object-name>derive</object-name>
    <object-name>lights</object-name>

    <object-name>trous</object-name>
    <object-name>echappe</object-name>

    <!-- Transparence -->
    <object-name>vitres</object-name>
      <object-name>intvitres</object-name>
    
    <object-name>verrelampe</object-name>
    <object-name>vitreAG</object-name>
    <object-name>vitreAD</object-name>
    <object-name>vitreBG</object-name>
    <object-name>vitreBD</object-name>
    <object-name>redlight</object-name>
    <object-name>greenlight</object-name>
  </animation>




  <effect>
    <inherits-from>Aircraft/R44/Models/Effects/reflect-uber</inherits-from>
   
    <object-name>fuselage</object-name>
    <object-name>patins</object-name>
    <object-name>supportlampe</object-name>
    <object-name>protection</object-name>
    <object-name>porteAG</object-name>
    <object-name>porteAD</object-name>
    <object-name>porteBG</object-name>
    <object-name>porteBD</object-name>
    <object-name>pate</object-name>
    <object-name>derive</object-name>
    <object-name>lights</object-name>
  </effect>


 
 <effect>
    <inherits-from>Aircraft/R44/Models/Effects/glassout</inherits-from>
    <object-name>windshield</object-name>
    <object-name>windowRR</object-name>
    <object-name>windowRL</object-name>
    <object-name>windowFR</object-name>
     <object-name>windowFL</object-name>
  </effect>
  
  <animation>
  <type>select</type>
 <object-name>windshield</object-name>
    <object-name>windowRR</object-name>
    <object-name>windowRL</object-name>
    <object-name>windowFR</object-name>
     <object-name>windowFL</object-name>

  <condition>
   <not>
   <equals>
    <property>sim/current-view/internal</property>
    <value>true</value>
   </equals>
   </not>
  </condition>
 </animation>
 


  <animation>
    <type>noshadow</type>
    <object-name>vitres</object-name>
    <object-name>verrelampe</object-name>
    <object-name>vitreAG</object-name>
    <object-name>vitreAD</object-name>
    <object-name>vitreBG</object-name>
    <object-name>vitreBD</object-name>
    <object-name>redlight</object-name>
    <object-name>greenlight</object-name>
  </animation>
  

   <effect>

  <inherits-from>Effects/glass</inherits-from>
  <object-name>intvitres</object-name>
   <object-name>vitreAG</object-name>
    <object-name>vitreAD</object-name>
    <object-name>vitreBG</object-name>
    <object-name>vitreBD</object-name>
     <object-name>vitres</object-name>
      
  </effect>



  
  
 

 

</PropertyList>

