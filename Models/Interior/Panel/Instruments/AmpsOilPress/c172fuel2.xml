<?xml version="1.0"?>

<PropertyList>

    <path>c172fuel.ac</path>

    <effect>
        <inherits-from>../../../../Effects/interior/c172p-interior-radiance</inherits-from>
        <object-name>Face</object-name>
        <object-name>LeftFuelNeedle</object-name>
        <object-name>RightFuelNeedle</object-name>
    </effect>

    <animation>
        <type>material</type>
        <object-name>Face</object-name>
        <object-name>LeftFuelNeedle</object-name>
        <object-name>RightFuelNeedle</object-name>
         <emission>
      <red>   0.20 </red>
      <green> 0.20 </green>
      <blue>  0.05 </blue>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
    </emission>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>LeftFuelNeedle</object-name>
        <property>systems[0]/electrical[0]/amps[0]</property>
        <interpolation>
            <entry>
                <ind>-70</ind>
                <dep>-29</dep>
            </entry>
            <entry>
                <ind>-50</ind>
                <dep>-18</dep>
            </entry>
            <entry>
                <ind>-20</ind>
                <dep>-7</dep>
            </entry>
            <entry>
                <ind>0</ind>
                <dep>0</dep>
            </entry>
            <entry>
                <ind>20</ind>
                <dep>5</dep>
            </entry>
            <entry>
                <ind>50</ind>
                <dep>16</dep>
            </entry>
            <entry>
                <ind>70</ind>
                <dep>27</dep>
            </entry>
        </interpolation>
        <center>
            <x-m>0.001</x-m>
            <y-m>-0.016</y-m>
            <z-m>-0.018</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>RightFuelNeedle</object-name>
          <property>oilpressure</property>
        <interpolation>
            <entry>
                <ind>0</ind>
                <dep>-29</dep>
            </entry>
            <entry>
                <ind>5</ind>
                <dep>-18</dep>
            </entry>
            <entry>
                <ind>10</ind>
                <dep>-7</dep>
            </entry>
            <entry>
                <ind>15</ind>
                <dep>5</dep>
            </entry>
            <entry>
                <ind>20</ind>
                <dep>16</dep>
            </entry>
            <entry>
                <ind>24</ind>
                <dep>27</dep>
            </entry>
        </interpolation>
        <center>
             <x-m>0.001</x-m>
            <y-m>0.016</y-m>
            <z-m>-0.012</z-m>
        </center>
        <axis>
            <x>-1</x>
            <y>0</y>
            <z>0</z>
        </axis>
    </animation>
	
	 <!-- Compositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.025</x-m>
    <y-m>0.017</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.2</r>
      <g>1</g>
      <b>0.2</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>1</spot-exponent>
  <spot-cutoff>30</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.02</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>

 <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.025</x-m>
    <y-m>-0.017</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.2</r>
      <g>1</g>
      <b>0.2</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>1</spot-exponent>
  <spot-cutoff>30</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.02</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>

<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/electric/directbat-switch</property>
    <value>1</value>
   </equals>
  
  </condition>
 </animation>

 <!--end compositor light -->

</PropertyList>
